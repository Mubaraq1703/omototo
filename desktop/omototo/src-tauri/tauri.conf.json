{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omototo",
  "version": "0.1.0",
  "identifier": "com.dell.omototo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OMOTOTO WAREHOUSE MANAGEMENT SOFTWARE",
        "width": 850,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "webview",
        "title": "OMOTOTO WAREHOUSE MANAGEMENT SOFTWARE",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; connect-src 'self' https://omototo.onrender.com; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["https://omototo.onrender.com/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}